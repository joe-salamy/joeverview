#!/usr/bin/env bash
# Fuzzy jump to exact tmux pane with live content preview. Single-session optimized.
# Bound to `prefix O` via display-popup. Enter=jumps (auto-switches window), Ctrl-X=kills + reloads.
# Preview is visible-only + ANSI + nowrap; snapshots identify, jumping renders.
# Row field 1 is #{pane_id} (hidden via --with-nth): bare `W.P` targets can
# collide with session names, so every -t uses the stable %id.
set -u
LIST="tmux list-panes -s -F '#{pane_id} #{window_index}.#{pane_index} │ #{window_name} │ #{pane_title} │ #{pane_current_path}'"
PREVIEW="tmux capture-pane -pe -t {1} 2>/dev/null | sed -e 's/[[:space:]]*\$//' || tmux capture-pane -p -t {1} 2>/dev/null | sed -e 's/[[:space:]]*\$//'"
TARGET=$(eval "$LIST" | fzf --ansi --with-nth=2.. --reverse --border --height=100% \
  --prompt='pane> ' \
  --header='enter=jump  ctrl-x=kill-pane' \
  --preview="$PREVIEW" \
  --preview-window='right:60%:nowrap' \
  --bind="ctrl-x:execute-silent(tmux kill-pane -t {1})+reload($LIST)") || exit 0
[ -z "${TARGET:-}" ] && exit 0
TARGET_ID=$(printf '%s' "$TARGET" | cut -d' ' -f1)
[ -z "$TARGET_ID" ] && exit 0
tmux select-pane -t "$TARGET_ID"
