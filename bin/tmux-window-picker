#!/usr/bin/env bash
# Arrow-navigated 2x2 snapshot grid for tmux windows across sessions. Bound to `prefix o`.
# Full keys: docs/USAGE.md in the repo.
# Each cell shows the BOTTOM-LEFT of the active pane capture, truncated to cell width at full resolution.
set -u
# JOEVERVIEW_PROFILE=1 prints load-phase timings (ns epoch) to stderr.
prof() { [[ -n ${JOEVERVIEW_PROFILE:-} ]] && printf '[prof %s] %s\n' "$(date +%s%N)" "$*" >&2 || :; }
COLS=2; VROWS=2  # Fixed 2x2: mid_y/bot_y and the single mid divider assume VROWS=2.

command -v python3 >/dev/null 2>&1 || { echo "tmux-window-grid needs python3" >&2; exit 1; }

# Visible-width-aware truncation: keeps SGR colors atomic, strips OSC
# hyperlinks, never splits UTF-8 (system `cut -c` counts bytes). Program goes
# via -c so the data stream keeps stdin (a heredoc would swallow the pipe).
# Optional second arg keeps only the last N non-blank (has a visible
# non-space char) lines, so top-anchored TUIs stay identifiable instead of
# showing blank tail. SGR-colored padding still counts as blank.
PY="import re, sys, unicodedata
w = int(sys.argv[1])
keep = int(sys.argv[2]) if len(sys.argv) > 2 else None
osc = re.compile(r'\x1b\][^\x07\x1b]*(?:\x07|\x1b\\\\)')
sgr = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
def vw(ch):
    e = unicodedata.east_asian_width(ch)
    if e in ('W', 'F'):
        return 2
    if unicodedata.combining(ch):
        return 0
    return 1
rows = []
for raw in sys.stdin:
    line = osc.sub('', raw.rstrip('\n'))
    out = []
    v = 0
    content = False
    saw = False
    done = False
    for tok in re.split(r'(\x1b\[[0-9;]*[A-Za-z])', line):
        if done or not tok:
            continue
        if sgr.fullmatch(tok):
            out.append(tok)
            saw = True
            continue
        for ch in tok:
            c = vw(ch)
            if v + c > w:
                done = True
                break
            out.append(ch)
            v += c
            if not ch.isspace():
                content = True
    if saw:
        out.append('\x1b[0m')
    # Folded-in rstrip (was a sed stage): capture-pane pads lines with spaces
    # that must not eat cell width; SGR tokens are multi-char, never popped.
    while out and len(out[-1]) == 1 and out[-1] in ' \t':
        out.pop()
    rows.append((content, ''.join(out)))
if keep is not None:
    texts = [t for c, t in rows if c][-keep:] if keep > 0 else []
else:
    texts = [t for _, t in rows]
sys.stdout.write('\n'.join(texts) + ('\n' if texts else ''))"
trunc() { python3 -c "$PY" "$@"; }

# Popup canvas is the fullscreen popup's own tty, not the invoker pane:
# #{pane_height}/#{pane_width} shrink the grid when opened from a split.
read -r H W < <(stty size 2>/dev/null) 2>/dev/null || read -r H W < <(tmux display-message -p '#{client_height} #{client_width}')
read -r cur_sid cur < <(tmux display-message -p '#{session_id} #{window_id}')
cell_w=$(((W - 7) / COLS)); ((cell_w < 20)) && cell_w=20
title_w=$((cell_w - 2))
band_h=$(((H - 9) / VROWS)); ((band_h < 4)) && band_h=4
snap_h=$((band_h - 1))
vx=$((2 + cell_w + 1))
bot_y=$((H - 2))
mid_y=$((band_h + 3))
(( H < 14 )) && H=14; (( W < 47 )) && W=47

TMP=$(mktemp -d "${TMPDIR:-/tmp}/tmux-grid.XXXXXX") || exit 1
declare -a SESS_IDS SESS_NAMES SESS_START SESS_COUNT
declare -a IDS TITLES ALERTS WIDX WIN_SESS RAW_TITLES
declare -A SNAP SESS_MED SESS_MEDW
# Rebuild session/window metadata from tmux. Snapshots (SNAP + $TMP files)
# are keyed by stable window_id, so surviving cells keep their captures
# across create/kill refreshes; only missing cells fault in via
# ensure_visible(). Stale windows/sessions are garbage-collected here.
# Session medallions are keyed by session_id, but their arrow decoration
# and max width depend on nsess>1, so they are dropped whenever the
# session count or a session name changes (not just for dead IDs).
# Returns 1 when no windows remain.
load_data() {
  local sid sname wid widx wname wtitle wpath panes alert suffix c k old_nsess
  local -A seen sess_seen old_names
  old_nsess=${nsess:-0}
  if [[ -n ${SESS_IDS[@]+x} ]]; then
    for ((k = 0; k < old_nsess; k++)); do old_names[${SESS_IDS[$k]}]=${SESS_NAMES[$k]}; done
  fi
  SESS_IDS=(); SESS_NAMES=(); SESS_START=(); SESS_COUNT=()
  IDS=(); TITLES=(); ALERTS=(); WIDX=(); WIN_SESS=(); RAW_TITLES=()
  nsess=0; i=0
  while IFS=$'\t' read -r sid sname; do
    SESS_IDS[$nsess]=$sid
    SESS_NAMES[$nsess]=$sname
    SESS_START[$nsess]=$i
    c=0
    while IFS=$'\t' read -r wid widx wname wtitle wpath panes alert; do
      IDS[$i]=$wid
      WIDX[$i]=$widx
      ALERTS[$i]=$alert
      WIN_SESS[$i]=$sid
      seen[$wid]=1
      suffix=""
      if ((panes > 1)); then suffix=" ⧉ $panes"; fi
      RAW_TITLES[$i]="[$widx] $wname │ $wtitle │ $wpath$suffix"
      i=$((i + 1)); c=$((c + 1))
    done < <(tmux list-windows -t "$sid" -F "#{window_id}	#{window_index}	#{window_name}	#{pane_title}	#{pane_current_path}	#{window_panes}	#{?window_bell_flag,B,}#{?window_activity_flag,A,}")
    SESS_COUNT[$nsess]=$c
    sess_seen[$sid]=1
    nsess=$((nsess + 1))
  done < <(tmux list-sessions -F "#{session_id}	#{session_name}")
  n=$i
  [ "$n" -eq 0 ] && return 1
  # Drop snapshots for dead IDs; survivors keep their cache so
  # add/delete only captures the missing cells in ensure_visible().
  if [[ -n ${SNAP[@]+x} ]]; then
    for k in "${!SNAP[@]}"; do
      if [[ -z ${seen[$k]+_} ]]; then unset "SNAP[$k]"; rm -f "$TMP/$k" 2>/dev/null || true; fi
    done
  fi
  if (( nsess != old_nsess )); then
    # Arrow decoration and maxw depend on nsess>1: every cached medallion is stale.
    SESS_MED=(); SESS_MEDW=()
  elif [[ -n ${SESS_MED[@]+x} ]]; then
    for k in "${!SESS_MED[@]}"; do
      if [[ -z ${sess_seen[$k]+_} ]]; then unset "SESS_MED['$k']" "SESS_MEDW['$k']"; fi
    done
    # Out-of-band renames: explicit renames already drop their own entry.
    for ((k = 0; k < nsess; k++)); do
      sid=${SESS_IDS[$k]}
      if [[ -n ${SESS_MED[$sid]+_} && -n ${old_names[$sid]+_} ]]; then
        if [[ "${old_names[$sid]}" != "${SESS_NAMES[$k]}" ]]; then
          unset "SESS_MED['$sid']" "SESS_MEDW['$sid']"
        fi
      fi
    done
  fi
  # Titles truncate in one python pass; snapshots fault in per visible page.
  mapfile -t TITLES < <(printf '%s\n' "${RAW_TITLES[@]}" | trunc "$title_w")
  unset RAW_TITLES
  prof "meta n=$n nsess=$nsess"
}
# Clamp top so sel sits on the visible page.
place_top() {
  local rstart cnt max_top
  rstart=$(( sel - (sel - s0) % COLS ))
  cnt=$((send - s0))
  max_top=$(( (cnt - 3) / COLS * COLS + s0 ))
  (( max_top < s0 )) && max_top=$s0
  if (( rstart < max_top )); then top=$rstart; else top=$max_top; fi
}
# Re-read metadata and reseat sess/sel/top by stable ID (want_wid="" falls
# back to want_off, then clamps into the session). keep_bar preserves
# session-bar focus for r. Full draw; exits quietly when nothing remains
# (e.g. last window killed).
# Args: $1=want_sid $2=want_wid ("" = skip) $3=keep_bar $4=want_off (kill path only).
refresh_to() {
  local want_sid=${1:-} want_wid=${2:-} keep_bar=${3:-0} want_off=${4:-} k found=0
  load_data || exit 0
  sess=0
  if [[ -n $want_sid ]]; then
    for ((k = 0; k < nsess; k++)); do
      if [[ ${SESS_IDS[$k]} == "$want_sid" ]]; then sess=$k; found=1; break; fi
    done
  else
    found=1
  fi
  s0=${SESS_START[$sess]}; send=$((s0 + SESS_COUNT[$sess]))
  sel=$s0
  if [[ -n $want_wid ]]; then
    for ((k = s0; k < send; k++)); do
      if [[ ${IDS[$k]} == "$want_wid" ]]; then sel=$k; break; fi
    done
  elif [[ -n $want_off ]] && (( found )); then
    sel=$((s0 + want_off))
  fi
  (( sel < s0 )) && sel=$s0
  (( sel >= send )) && sel=$((send - 1))
  bar=$keep_bar
  place_top
  draw
}
# New window in the viewed session, starting in the selected cell's
# directory; grid cursor lands on it. Created detached (-d) so the
# underlying client keeps its window — overview stays open. Falls back
# to tmux default-path when the path is empty/unreadable (e.g. deleted dir).
do_new_window() {
  local target newid dir
  target=${SESS_IDS[$sess]}
  dir=$(tmux display-message -p -t "${IDS[$sel]}" '#{pane_current_path}' 2>/dev/null) || dir=""
  if [[ -n $dir ]]; then
    newid=$(tmux new-window -d -P -F "#{window_id}" -t "$target" -c "$dir" 2>/dev/null) || \
      newid=$(tmux new-window -d -P -F "#{window_id}" -t "$target" 2>/dev/null) || return 0
  else
    newid=$(tmux new-window -d -P -F "#{window_id}" -t "$target" 2>/dev/null) || return 0
  fi
  # Drop any stale capture under a recycled window_id so ensure_visible()
  # faults the new window in fresh (ids are unique in practice).
  unset "SNAP[$newid]" 2>/dev/null || true
  rm -f "$TMP/$newid" 2>/dev/null || true
  refresh_to "$target" "$newid" 0
}
# Kill the selected window (grid focus only); stays at the same offset so
# the next window slides under the cursor (clamped at the end).
do_kill_window() {
  (( bar )) && return 0
  local target=${SESS_IDS[$sess]} off=$((sel - s0))
  tmux kill-window -t "${IDS[$sel]}" 2>/dev/null || return 0
  refresh_to "$target" "" 0 "$off"
}
# New detached session; grid lands on it with bar focus so the user can
# keep paging or dive in (Down, then c for windows). Full refresh.
do_new_session() {
  local newsid
  newsid=$(tmux new-session -d -P -F "#{session_id}" 2>/dev/null) || return 0
  refresh_to "$newsid" "" 1
}
# Kill the viewed session (bar focus only, never the last one — killing
# the sole session would strand the client); lands on the session now at
# the same position (neighbour slides in, clamped at the end) with bar
# focus, keeping the window offset like kill-window. Pre-switches the
# client when killing the attached session so the popup survives.
do_kill_session() {
  local target=${SESS_IDS[$sess]} fallback="" attached="" off=$((sel - s0))
  (( nsess > 1 )) || return 0
  if (( sess + 1 < nsess )); then fallback=${SESS_IDS[$((sess + 1))]}
  else fallback=${SESS_IDS[$((sess - 1))]}; fi
  attached=$(tmux display-message -p '#{session_id}' 2>/dev/null) || attached=""
  attached=${attached%% *}  # live reply is one id; other contexts may append the window id
  if [[ -n $attached && $target == "$attached" ]]; then
    tmux switch-client -t "$fallback" 2>/dev/null || return 0
  fi
  tmux kill-session -t "$target" 2>/dev/null || return 0
  refresh_to "$fallback" "" 1 "$off"
}
# Swap the selected window with its neighbour within the viewed session;
# cursor follows the moved window by stable ID. Grid focus only.
do_move_window() {
  local dir=$1 wid target
  (( bar )) && return 0
  wid=${IDS[$sel]}
  if (( dir < 0 )); then
    (( sel <= s0 )) && return 0
    target=${IDS[$((sel - 1))]}
  else
    (( sel + 1 >= send )) && return 0
    target=${IDS[$((sel + 1))]}
  fi
  tmux swap-window -s "$wid" -t "$target" 2>/dev/null || return 0
  refresh_to "${SESS_IDS[$sess]}" "$wid" 0
}
# Rename prompt on the footer row: leaves nav mode, shows the cursor, reads
# a line char-by-char with manual echo. Enter submits, Backspace erases,
# lone Esc aborts ("" = keep). Escape sequences are not text: Esc aborts and
# any trailing bytes reprocess as nav keys. Sets READ_NAME ("" = keep).
# Called directly (never in $()) so the prompt reaches the popup tty.
read_name() {
  local kind=$1 old=$2 ch buf=""
  READ_NAME=""
  at $((H - 1)) 0
  printf '\x1b[?25h'
  stty -echo -icanon min 1 time 0 2>/dev/null || true
  printf 'rename %s [%s]: ' "$kind" "$old"
  while IFS= read -rsn1 ch || { buf=""; break; }; do
    if [[ -z ${ch:-} || $ch == $'\n' || $ch == $'\r' ]]; then
      break
    elif [[ $ch == $'\x1b' ]]; then
      buf=""
      break
    elif [[ $ch == $'\x7f' || $ch == $'\b' ]]; then
      if [[ -n $buf ]]; then
        buf=${buf%?}
        printf '\b \b'
      fi
    elif [[ $ch < $' ' ]]; then
      continue
    else
      buf+=$ch
      printf '%s' "$ch"
    fi
  done
  READ_NAME=$buf
  stty -echo -icanon min 1 time 0 2>/dev/null || true
  printf '\x1b[?25l'
}
# Rename the selected window (grid focus only); snapshots are keyed by
# stable ID so the capture survives, titles rebuild in refresh_to.
do_rename_window() {
  (( bar )) && return 0
  local wid=${IDS[$sel]} sid=${SESS_IDS[$sess]} old
  old=$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null) || old=""
  read_name "window" "$old"
  [[ -z ${READ_NAME:-} || $READ_NAME == "$old" ]] && { draw; return 0; }
  tmux rename-window -t "$wid" "$READ_NAME" 2>/dev/null || { draw; return 0; }
  refresh_to "$sid" "$wid" 0
}
# Rename the viewed session (bar focus only); drops the cached medallion
# so the new name stamps fresh, keeping the window offset behind the bar.
# Empty input keeps the old name.
do_rename_session() {
  (( bar )) || return 0
  local sid=${SESS_IDS[$sess]} old off=$((sel - s0))
  old=${SESS_NAMES[$sess]}
  read_name "session" "$old"
  [[ -z ${READ_NAME:-} || $READ_NAME == "$old" ]] && { draw; return 0; }
  tmux rename-session -t "$sid" "$READ_NAME" 2>/dev/null || { draw; return 0; }
  unset "SESS_MED['$sid']" "SESS_MEDW['$sid']" 2>/dev/null || true
  refresh_to "$sid" "" 1 "$off"
}
load_data || { rm -rf "$TMP"; exit 0; }
# Start on the current window, not always cell 0.
sel=0
sess=0
for ((k = 0; k < n; k++)); do
  if [[ ${IDS[$k]} == "$cur" ]]; then sel=$k; break; fi
done
for ((k = 0; k < nsess; k++)); do
  if [[ ${SESS_IDS[$k]} == "$cur_sid" ]]; then sess=$k; break; fi
done
s0=${SESS_START[$sess]}; send=$((s0 + SESS_COUNT[$sess]))
place_top
# On-demand snapshots keyed by stable window_id: a present non-empty SNAP entry (or
# its $TMP/$wid backing file) is the loaded flag. Empty captures (fresh shell
# pre-paint) are never pinned so later draws retry. draw() ensures its page,
# so scrolls and session switches fault missing cells in synchronously,
# while add/delete refreshes reuse surviving cells and capture only the new one.
load_cell() {
  local wid=${IDS[$1]} f
  f="$TMP/$wid"
  if [[ -n ${SNAP[$wid]+_} ]]; then [[ -n ${SNAP[$wid]} ]] && return 0; fi
  if [[ -f $f && -s $f ]]; then SNAP[$wid]=$(<"$f"); [[ -n ${SNAP[$wid]} ]] && return 0; fi
  tmux capture-pane -pe -t "$wid" 2>/dev/null | trunc "$cell_w" "$snap_h" > "$f"
  if [[ -s $f ]]; then SNAP[$wid]=$(<"$f"); else rm -f "$f"; unset "SNAP[$wid]" 2>/dev/null || true; fi
}
ensure_visible() {
  local e=$((top + COLS * VROWS)) k
  ((e > send)) && e=$send
  for ((k = top; k < e; k++)); do load_cell "$k"; done
}
bar=0

saved_stty=$(stty -g 2>/dev/null || true)
cleanup() { printf '\x1b[?25h'; [ -n "${saved_stty:-}" ] && stty "$saved_stty" 2>/dev/null; rm -rf "$TMP"; }
trap cleanup EXIT
printf '\x1b[?25l\x1b[2J'
stty -echo -icanon min 1 time 0 2>/dev/null

at() { printf '\x1b[%d;%dH\x1b[K' "$(($1 + 1))" "$(($2 + 1))"; }

put() { printf -v __put '\x1b[%d;%dH\x1b[K%s' "$(($1 + 1))" "$(($2 + 1))" "$3"; FRAME+=$__put; }
nput() { printf -v __nput '\x1b[%d;%dH%s' "$(($1 + 1))" "$(($2 + 1))" "$3"; FRAME+=$__nput; }
# Alert style: bell=bold red, activity=bold yellow (bell wins if both).
# Selected cells fold reverse into the same SGR so no inner reset kills it.
title_cell() {
  local idx=$1 selected=$2 text
  text="${TITLES[$idx]}"
  case "${ALERTS[$idx]}" in
    *B*) if ((selected)); then printf '\x1b[7;1;31m%s\x1b[0m' "$text"; else printf '\x1b[1;31m%s\x1b[0m' "$text"; fi ;;
    *A*) if ((selected)); then printf '\x1b[7;1;33m%s\x1b[0m' "$text"; else printf '\x1b[1;33m%s\x1b[0m' "$text"; fi ;;
    *) if ((selected)); then printf '\x1b[7m%s\x1b[0m' "$text"; else printf '%s' "$text"; fi ;;
  esac
}
# Repaint one visible title row (both cells + gutter + borders) without
# wiping the sibling: clear once at row start, then write with no-EL moves.
paint_row() {
  local r=$1 roff base idx c coff
  if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
  base=$((top + r * COLS))
  # Arm-aware frame (junctions close with corners): skip border ticks with no occupied owner; never invent arms.
  at "$roff" 0
  (( base < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) 1 '│'
  for ((c = 0; c < COLS; c++)); do
    idx=$((base + c))
    if ((c == 0)); then coff=2; else coff=$((vx + 2)); fi
    if ((idx < send)); then
      if ((idx == sel)); then printf '\x1b[%d;%dH%s' $((roff + 1)) $((coff + 1)) "$(title_cell "$idx" 1)"
      else printf '\x1b[%d;%dH%s' $((roff + 1)) $((coff + 1)) "$(title_cell "$idx" 0)"; fi
    fi
  done
  (( base < send || base + 1 < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) $((vx + 1)) '│'
  (( base + 1 < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) "$W" '│'
  return 0
}
vw_of() { python3 -c 'import re,sys,unicodedata; t=re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", sys.stdin.read()); print(sum(2 if unicodedata.east_asian_width(c) in ("W","F") else (0 if unicodedata.combining(c) else 1) for c in t))'; }
# Session medallion for the top border: padded arrows when paging is
# possible, padded bare name when it is not (single session hides the bar
# entirely — no focus, no hint). Truncated to fit between the
# ' Windows ' stamp and the corners. Focus reverses the full label, wrapped
# with a 2-cell normal-video gap each side so white never touches ─
# (focused footprint = label + 4).
sess_label() {
  local maxw nm
  if ((nsess > 1)); then
    maxw=$((W - 38)); ((maxw < 8)) && maxw=8
    nm=$(printf '%s' "${SESS_NAMES[$sess]}" | trunc "$maxw")
    printf '  ←  %s  →  ' "$nm"
  else
    maxw=$((W - 32)); ((maxw < 8)) && maxw=8
    nm=$(printf '%s' "${SESS_NAMES[$sess]}" | trunc "$maxw")
    printf '  %s  ' "$nm"
  fi
}
# Footer is the contract: every working key for the current focus is listed,
# nothing unlisted works. Grid rows show window ops only (c = window,
# X = window); the bar shows session ops only (N = session, X = session).
footext() {
  local rel=$((top - s0)) cnt=$((send - s0)) hi lo
  hi=$((rel + 1)); lo=$((rel + COLS * VROWS)); ((lo > cnt)) && lo=$cnt
  if ((bar)); then
    if ((nsess > 1)); then printf '←→/ad switch · ↓/s back · Enter attach · N new-session · R rename · X kill-session · r refresh · q/Esc quit · session %d/%d' "$((sess + 1))" "$nsess"
    else printf '↓/s back · Enter attach · N new-session · R rename · r refresh · q/Esc quit · session %d/%d' "$((sess + 1))" "$nsess"; fi
  else printf '↑↓←→/WASD move · ↑ sessions · Enter/0-9 jump · c new-window · R rename · < > move window · X kill · r refresh · q/Esc quit · %d-%d/%d' "$hi" "$lo" "$cnt"; fi
}
# Page to the session `ns` steps away: reset to its first page, keep bar
# focus so the user can keep paging. Full draw — the only bar painter.
switch_sess() {
  (( nsess > 1 )) || return 0
  sess=$(( (sess + $1 + nsess) % nsess ))
  s0=${SESS_START[$sess]}; send=$((s0 + SESS_COUNT[$sess]))
  sel=$s0; top=$s0; bar=1
  draw
}
# Horizontal border row for one occupancy pair: ends + center junction
# follow the left/right occupancy ($4/$5); the mid divider is separate.
hborder() {
  local row=$1 le=$2 re=$3 ol=$4 or=$5 jb=$6 jl=$7 jr=$8 seg x
  if (( ol )); then seg=$le; else seg=' '; fi
  for ((x = 1; x <= W - 2; x++)); do
    if ((x == vx)); then
      if (( ol && or )); then seg+=$jb
      elif (( ol )); then seg+=$jl
      elif (( or )); then seg+=$jr
      else seg+=' '; fi
    elif ((x < vx)); then
      if (( ol )); then seg+='─'; else seg+=' '; fi
    else
      if (( or )); then seg+='─'; else seg+=' '; fi
    fi
  done
  if (( or )); then seg+=$re; else seg+=' '; fi
  put "$row" 0 "$seg"
}
draw() {
  local b0 b1 b2 b3 seg x y r c idx coff roff l sbar sbx sblen lines
  ensure_visible
  if [[ -z ${DREW:-} ]]; then DREW=1; prof "ready n=$n"; fi
  FRAME=$'\x1b[?25l'
  # Arm-aware frame: same geometry/sizes; each junction picks the glyph
  # matching its present arms (b0..b3 = visible occupancy of the 4 cells),
  # so edges close with corners instead of dangling tees/crosses.
  # Bounds are the visible session's [top, send), never the global list.
  (( top < send )) && b0=1 || b0=0
  (( top + 1 < send )) && b1=1 || b1=0
  (( top + 2 < send )) && b2=1 || b2=0
  (( top + 3 < send )) && b3=1 || b3=0
  hborder 0 '╭' '╮' "$b0" "$b1" '┬' '╮' '╭'
  nput 0 2 ' Windows '
  [[ -n ${SESS_MED[${SESS_IDS[$sess]}]+_} ]] || { SESS_MED[${SESS_IDS[$sess]}]=$(sess_label); SESS_MEDW[${SESS_IDS[$sess]}]=$(printf '%s' "${SESS_MED[${SESS_IDS[$sess]}]}" | vw_of); }
  sbar=${SESS_MED[${SESS_IDS[$sess]}]}; sblen=${SESS_MEDW[${SESS_IDS[$sess]}]}; sbx=$(((W - sblen) / 2)); ((sbx < 12)) && sbx=12
  if ((bar)); then
    # 2-cell normal-video gap each side so reverse never touches the border dashes.
    # Focused footprint = label + 4; recenter so the notch covers the full width.
    printf -v sbar '  \x1b[7m%s\x1b[0m  ' "$sbar"
    sblen=$((sblen + 4))
    sbx=$(((W - sblen) / 2)); ((sbx < 12)) && sbx=12
  fi
  nput 0 "$sbx" "$sbar"
  for ((y = 1; y <= bot_y - 1; y++)); do
    ((y == mid_y)) && continue
    if ((y < mid_y)); then
      if (( top < send )); then nput "$y" 0 '│'; else nput "$y" 0 ' '; fi
      if (( top + 1 < send )); then nput "$y" $((W - 1)) '│'; else nput "$y" $((W - 1)) ' '; fi
    else
      if (( top + 2 < send )); then nput "$y" 0 '│'; else nput "$y" 0 ' '; fi
      if (( top + 3 < send )); then nput "$y" $((W - 1)) '│'; else nput "$y" $((W - 1)) ' '; fi
    fi
  done
  hborder "$bot_y" '╰' '╯' "$b2" "$b3" '┴' '╯' '╰'
  for ((y = 1; y <= bot_y - 1; y++)); do
    ((y == mid_y)) && continue
    if ((y < mid_y)); then
      # Notch the divider where it passes under the session medallion,
      # so the column border never touches the session name.
      if (( top < send || top + 1 < send )) && (( y != 1 || vx < sbx || vx >= sbx + sblen )); then nput "$y" "$vx" '│'; else nput "$y" "$vx" ' '; fi
    else
      if (( top + 2 < send || top + 3 < send )); then nput "$y" "$vx" '│'; else nput "$y" "$vx" ' '; fi
    fi
  done
  if (( b0 && b2 )); then seg='├'
  elif (( b0 )); then seg='╰'
  elif (( b2 )); then seg='╭'
  else seg=' '; fi
  for ((x = 1; x <= W - 2; x++)); do
    if ((x == vx)); then
      l=$(( b0 || b2 )); r=$(( b1 || b3 )); u=$(( b0 || b1 )); d=$(( b2 || b3 ))
      if (( l && r && u && d )); then seg+='┼'
      elif (( l && r && u )); then seg+='┴'
      elif (( l && r && d )); then seg+='┬'
      elif (( l && u && d )); then seg+='┤'
      elif (( r && u && d )); then seg+='├'
      elif (( l && r )); then seg+='─'
      elif (( u && d )); then seg+='│'
      elif (( l && u )); then seg+='╯'
      elif (( l && d )); then seg+='╮'
      elif (( r && u )); then seg+='╰'
      elif (( r && d )); then seg+='╭'
      elif (( l || r )); then seg+='─'
      elif (( u || d )); then seg+='│'
      else seg+=' '; fi
    elif ((x < vx)); then
      if (( b0 || b2 )); then seg+='─'; else seg+=' '; fi
    else
      if (( b1 || b3 )); then seg+='─'; else seg+=' '; fi
    fi
  done
  if (( b1 && b3 )); then seg+='┤'
  elif (( b1 )); then seg+='╯'
  elif (( b3 )); then seg+='╮'
  else seg+=' '; fi
  put "$mid_y" 0 "$seg"
  for ((r = 0; r < VROWS; r++)); do
    if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
    for ((c = 0; c < COLS; c++)); do
      idx=$((top + r * COLS + c))
      if ((c == 0)); then coff=2; else coff=$((vx + 2)); fi
      if ((idx < send)); then
        if ((idx == sel && bar == 0)); then put "$roff" "$coff" "$(title_cell "$idx" 1)"
        else put "$roff" "$coff" "$(title_cell "$idx" 0)"; fi
        mapfile -t lines <<<"${SNAP[${IDS[$idx]}]}"
        for ((l = 0; l < snap_h; l++)); do
          put $((roff + 1 + l)) "$coff" "${lines[$l]:-}"
        done
      else
        for ((l = 0; l < band_h; l++)); do
          put $((roff + l)) "$coff" "$(printf '%*s' "$cell_w" '')"
        done
      fi
    done
  done
  # Cell puts use EL (clear-to-EOL), wiping the middle gutter + right border
  # on touched rows. Restore them with no-EL writes after the cells.
  for ((r = 0; r < VROWS; r++)); do
    if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
    for ((l = 0; l < band_h; l++)); do
      y=$((roff + l))
      if ((r == 0)); then
        if (( top < send )); then nput "$y" 0 '│'; else nput "$y" 0 ' '; fi
        if (( top < send || top + 1 < send )); then nput "$y" "$vx" '│'; else nput "$y" "$vx" ' '; fi
        if (( top + 1 < send )); then nput "$y" $((W - 1)) '│'; else nput "$y" $((W - 1)) ' '; fi
      else
        if (( top + 2 < send )); then nput "$y" 0 '│'; else nput "$y" 0 ' '; fi
        if (( top + 2 < send || top + 3 < send )); then nput "$y" "$vx" '│'; else nput "$y" "$vx" ' '; fi
        if (( top + 3 < send )); then nput "$y" $((W - 1)) '│'; else nput "$y" $((W - 1)) ' '; fi
      fi
    done
  done
  put $((H - 1)) 0 "$(footext)"
  printf '%s' "$FRAME"
}

move_down() {
  local next=$((sel + COLS))
  if ((next < send)); then sel=$next; return; fi
  local last_start=$(( (send - 1 - s0) / COLS * COLS + s0 ))
  if ((sel < last_start)); then
    local t=$((last_start + (sel - s0) % COLS))
    ((t >= send)) && t=$((send - 1))
    sel=$t
  fi
}

# Jump to a window, switching session first when it lives elsewhere.
jump_win() {
  local j=$1 wsess
  wsess=${WIN_SESS[$j]}
  [[ $wsess != "$cur_sid" ]] && tmux switch-client -t "$wsess" 2>/dev/null
  tmux select-window -t "${IDS[$j]}"
  exit 0
}

main() {
local prev k b d j
draw
while IFS= read -rsn1 k; do
  prev=$sel
  if [[ $k == $'\x1b' ]]; then
    IFS= read -rsn1 -t 0.25 b || break
    [[ $b == '[' ]] || continue
    IFS= read -rsn1 -t 0.25 d || continue
    case $d in
      [0-9]) while [[ $d != [A-Za-z~] ]]; do IFS= read -rsn1 -t 0.05 d || break; done; continue ;;
      A) if ((bar)); then continue
         elif ((sel >= s0 + COLS)); then sel=$((sel - COLS))
         else bar=1; draw; continue; fi ;;
      B) if ((bar)); then bar=0; draw; continue
         else move_down; fi ;;
      C) if ((bar)); then switch_sess 1; continue
         else ((sel + 1 < send)) && sel=$((sel + 1)); fi ;;
      D) if ((bar)); then switch_sess -1; continue
         else ((sel > s0)) && sel=$((sel - 1)); fi ;;
      *) continue ;;
    esac
  elif [[ -z $k || $k == $'\n' ]]; then
    if ((bar)); then tmux switch-client -t "${SESS_IDS[$sess]}"; exit 0; fi
    jump_win "$sel"
  elif [[ $k == [qQ] ]]; then
    break
  elif [[ $k == [0-9] ]]; then
    (( bar )) && continue
    for ((j = s0; j < send; j++)); do
      if [[ ${WIDX[$j]} == "$k" ]]; then
        jump_win "$j"
      fi
    done
  elif [[ $k == [wW] ]]; then
    if ((bar)); then continue
    elif ((sel >= s0 + COLS)); then sel=$((sel - COLS))
    else bar=1; draw; continue; fi
  elif [[ $k == [sS] ]]; then
    if ((bar)); then bar=0; draw; continue
    else move_down; fi
  elif [[ $k == [aA] ]]; then
    if ((bar)); then switch_sess -1; continue
    else ((sel > s0)) && sel=$((sel - 1)); fi
  elif [[ $k == [dD] ]]; then
    if ((bar)); then switch_sess 1; continue
    else ((sel + 1 < send)) && sel=$((sel + 1)); fi
  elif [[ $k == [cC] ]]; then
    (( bar )) && continue
    do_new_window; continue
  elif [[ $k == [nN] ]]; then
    # Session creation lives on the session bar (strict two-mode).
    (( bar )) || continue
    do_new_session; continue
  elif [[ $k == "<" ]]; then
    do_move_window -1; continue
  elif [[ $k == ">" ]]; then
    do_move_window 1; continue
  elif [[ $k == X ]]; then
    # Capital-only kill: lowercase x stays ignored as a fat-finger guard
    # beside WASD. Grid focus kills the window, bar focus kills the viewed
    # session.
    if (( bar )); then do_kill_session; else do_kill_window; fi; continue
  elif [[ $k == r ]]; then
    # Explicit refresh: drop all cached captures/medallions so pane content
    # and renamed sessions fault in fresh (c/X reuse the cache on purpose).
    # Lowercase only: R is rename (visible in both footers).
    SNAP=(); SESS_MED=(); SESS_MEDW=()
    rm -f "$TMP"/* 2>/dev/null || true
    if ((bar)); then refresh_to "${SESS_IDS[$sess]}" "" 1
    else refresh_to "${SESS_IDS[$sess]}" "${IDS[$sel]}" 0; fi
    continue
  elif [[ $k == R ]]; then
    # Rename: window on grid focus, session on bar focus. Empty keeps old.
    if (( bar )); then do_rename_session; else do_rename_window; fi; continue
  else
    continue
  fi
  if ((prev == sel)); then continue; fi
  if ((sel >= top && sel <= top + COLS * VROWS - 1 && prev >= top && prev <= top + COLS * VROWS - 1)); then
    # Repaint whole title rows: per-cell EL wipes the sibling, so clear
    # once per row and rewrite both cells + gutter + borders.
    if (((prev - top) / COLS == (sel - top) / COLS)); then
      paint_row $(((sel - top) / COLS))
    else
      paint_row $(((prev - top) / COLS))
      paint_row $(((sel - top) / COLS))
    fi
    # Direct write (not put): FRAME is only flushed in draw().
    at $((H - 1)) 0; footext
  else
    while ((sel < top)); do top=$((top - COLS)); done
    while ((sel > top + COLS * VROWS - 1)); do top=$((top + COLS)); done
    draw
  fi
done
exit 0
}
main "$@"
