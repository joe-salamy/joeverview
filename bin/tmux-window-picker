#!/usr/bin/env bash
# Arrow-navigated 2x2 snapshot grid for tmux windows across sessions. Bound to `prefix o`.
# Static captures at launch (reopen to refresh). Arrows/WASD move, Up from the
# top row focuses the session switcher (Left/Right pages sessions, Down back),
# 0-9 jumps to the window with that index in this session, Enter jumps to the
# cell (or attaches to the focused session), q/Esc cancels. Each cell shows its
# title line with a ⧉N badge when the window holds N tmux panes, then the
# BOTTOM-LEFT of the active pane capture (last non-blank lines, truncated to
# cell width at full resolution — cut off, never scaled). Down from the bottom
# row scrolls.
set -u
COLS=2; VROWS=2

command -v python3 >/dev/null 2>&1 || { echo "tmux-window-grid needs python3" >&2; exit 1; }

# Visible-width-aware truncation: keeps SGR colors atomic, strips OSC
# hyperlinks, never splits UTF-8 (system `cut -c` counts bytes). Program goes
# via -c so the data stream keeps stdin (a heredoc would swallow the pipe).
# Optional second arg keeps only the last N non-blank (has a visible
# non-space char) lines, so top-anchored TUIs stay identifiable instead of
# showing blank tail. SGR-colored padding still counts as blank.
PY="import re, sys, unicodedata
w = int(sys.argv[1])
keep = int(sys.argv[2]) if len(sys.argv) > 2 else None
osc = re.compile(r'\x1b\][^\x07\x1b]*(?:\x07|\x1b\\\\)')
sgr = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
def vw(ch):
    e = unicodedata.east_asian_width(ch)
    if e in ('W', 'F'):
        return 2
    if unicodedata.combining(ch):
        return 0
    return 1
rows = []
for raw in sys.stdin:
    line = osc.sub('', raw.rstrip('\n'))
    out = []
    v = 0
    content = False
    saw = False
    done = False
    for tok in re.split(r'(\x1b\[[0-9;]*[A-Za-z])', line):
        if done or not tok:
            continue
        if sgr.fullmatch(tok):
            out.append(tok)
            saw = True
            continue
        for ch in tok:
            c = vw(ch)
            if v + c > w:
                done = True
                break
            out.append(ch)
            v += c
            if not ch.isspace():
                content = True
    if saw:
        out.append('\x1b[0m')
    rows.append((content, ''.join(out)))
if keep is not None:
    texts = [t for c, t in rows if c][-keep:] if keep > 0 else []
else:
    texts = [t for _, t in rows]
sys.stdout.write('\n'.join(texts) + ('\n' if texts else ''))"
trunc() { python3 -c "$PY" "$@"; }

H=$(tmux display-message -p '#{pane_height}'); W=$(tmux display-message -p '#{pane_width}')
cell_w=$(((W - 7) / COLS)); ((cell_w < 20)) && cell_w=20
title_w=$((cell_w - 2))
band_h=$(((H - 9) / VROWS)); ((band_h < 4)) && band_h=4
snap_h=$((band_h - 1))
vx=$((2 + cell_w + 1))
bot_y=$((H - 2))
mid_y=$((band_h + 3))

TMP=$(mktemp -d "${TMPDIR:-/tmp}/tmux-grid.XXXXXX") || exit 1
declare -a SESS_IDS SESS_NAMES SESS_START SESS_COUNT
declare -a IDS TITLES ALERTS WIDX WIN_SESS
nsess=0; i=0
cur_sid=$(tmux display-message -p '#{session_id}')
while IFS=$'\t' read -r sid sname; do
  SESS_IDS[$nsess]=$sid
  SESS_NAMES[$nsess]=$sname
  SESS_START[$nsess]=$i
  c=0
  while IFS=$'\t' read -r wid widx wname wtitle wpath panes alert; do
    IDS[$i]=$wid
    WIDX[$i]=$widx
    ALERTS[$i]=$alert
    WIN_SESS[$i]=$sid
    suffix=""
    if ((panes > 1)); then suffix=" ⧉$panes"; fi
    TITLES[$i]=$(printf '[%s] %s │ %s │ %s%s' "$widx" "$wname" "$wtitle" "$wpath" "$suffix" | trunc "$title_w")
    tmux capture-pane -pe -t "$wid" 2>/dev/null | sed -e 's/[[:space:]]*$//' | trunc "$cell_w" "$snap_h" > "$TMP/$i"
    # shellcheck disable=SC2178
    mapfile -t "SNAP_$i" < "$TMP/$i"
    i=$((i + 1)); c=$((c + 1))
  done < <(tmux list-windows -t "$sid" -F "#{window_id}	#{window_index}	#{window_name}	#{pane_title}	#{pane_current_path}	#{window_panes}	#{?window_bell_flag,B,}#{?window_activity_flag,A,}")
  SESS_COUNT[$nsess]=$c
  nsess=$((nsess + 1))
done < <(tmux list-sessions -F "#{session_id}	#{session_name}")
n=$i
[ "$n" -eq 0 ] && { rm -rf "$TMP"; exit 0; }

# Start on the current window, not always cell 0.
sel=0
sess=0
cur=$(tmux display-message -p '#{window_id}')
for ((k = 0; k < n; k++)); do
  if [[ ${IDS[$k]} == "$cur" ]]; then sel=$k; break; fi
done
for ((k = 0; k < nsess; k++)); do
  if [[ ${SESS_IDS[$k]} == "$cur_sid" ]]; then sess=$k; break; fi
done
s0=${SESS_START[$sess]}; send=$((s0 + SESS_COUNT[$sess]))
rstart=$(( sel - (sel - s0) % COLS ))
cnt=$((send - s0))
if (( cnt >= 3 )); then
  max_top=$(( (cnt - 3) / COLS * COLS + s0 ))
  if (( rstart < max_top )); then top=$rstart; else top=$max_top; fi
else
  top=$rstart
fi
bar=0

saved_stty=$(stty -g 2>/dev/null || true)
cleanup() { printf '\x1b[?25h'; [ -n "${saved_stty:-}" ] && stty "$saved_stty" 2>/dev/null; rm -rf "$TMP"; }
trap cleanup EXIT
printf '\x1b[?25l\x1b[2J'
stty -echo -icanon min 1 time 0 2>/dev/null

at() { printf '\x1b[%d;%dH\x1b[K' "$(($1 + 1))" "$(($2 + 1))"; }

put() { printf -v __put '\x1b[%d;%dH\x1b[K%s' "$(($1 + 1))" "$(($2 + 1))" "$3"; FRAME+=$__put; }
nput() { printf -v __nput '\x1b[%d;%dH%s' "$(($1 + 1))" "$(($2 + 1))" "$3"; FRAME+=$__nput; }
# Alert style: bell=bold red, activity=bold yellow (bell wins if both).
# Selected cells fold reverse into the same SGR so no inner reset kills it.
title_cell() {
  local idx=$1 selected=$2 bullet text
  if ((selected)); then bullet='● '; else bullet='○ '; fi
  text="${bullet}${TITLES[$idx]}"
  case "${ALERTS[$idx]}" in
    *B*) if ((selected)); then printf '\x1b[7;1;31m%s\x1b[0m' "$text"; else printf '\x1b[1;31m%s\x1b[0m' "$text"; fi ;;
    *A*) if ((selected)); then printf '\x1b[7;1;33m%s\x1b[0m' "$text"; else printf '\x1b[1;33m%s\x1b[0m' "$text"; fi ;;
    *) if ((selected)); then printf '\x1b[7m%s\x1b[0m' "$text"; else printf '%s' "$text"; fi ;;
  esac
}
# Repaint one visible title row (both cells + gutter + borders) without
# wiping the sibling: clear once at row start, then write with no-EL moves.
paint_row() {
  local r=$1 roff base idx c coff
  if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
  base=$((top + r * COLS))
  # Subtractive frame: skip border ticks with no occupied owner; never new glyphs.
  at "$roff" 0
  (( base < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) 1 '│'
  for ((c = 0; c < COLS; c++)); do
    idx=$((base + c))
    if ((c == 0)); then coff=2; else coff=$((vx + 2)); fi
    if ((idx < send)); then
      if ((idx == sel)); then printf '\x1b[%d;%dH%s' $((roff + 1)) $((coff + 1)) "$(title_cell "$idx" 1)"
      else printf '\x1b[%d;%dH%s' $((roff + 1)) $((coff + 1)) "$(title_cell "$idx" 0)"; fi
    fi
  done
  (( base < send || base + 1 < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) $((vx + 1)) '│'
  (( base + 1 < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) "$W" '│'
  return 0
}
# Session switcher for the top border: truncated to fit between the
# ' Windows ' stamp and the corners. Focus folds reverse like cell titles.
sess_label() {
  local maxw=$((W - 24)) nm
  ((maxw < 8)) && maxw=8
  nm=$(printf '%s' "${SESS_NAMES[$sess]}" | trunc "$maxw")
  printf '← %s →' "$nm"
}
footext() {
  local rel=$((top - s0)) cnt=$((send - s0)) hi lo
  hi=$((rel + 1)); lo=$((rel + COLS * VROWS)); ((lo > cnt)) && lo=$cnt
  if ((bar)); then printf '←/→ switch session · ↓ back · Enter attach · q cancel · session %d/%d' "$((sess + 1))" "$nsess"
  else printf '↑↓←→/WASD move · ↑ sessions · 0-9 jump · Enter jump · q cancel · %d-%d/%d' "$hi" "$lo" "$cnt"; fi
}
# Page to the session `ns` steps away: reset to its first page, keep bar
# focus so the user can keep paging. Full draw — the only bar painter.
switch_sess() {
  (( nsess > 1 )) || return 0
  sess=$(( (sess + $1 + nsess) % nsess ))
  s0=${SESS_START[$sess]}; send=$((s0 + SESS_COUNT[$sess]))
  sel=$s0; top=$s0; bar=1
  draw
}
draw() {
  FRAME=$'\x1b[?25l'
  # Subtractive frame: same geometry/sizes, only skip segments whose both
  # sides are empty (erased = blank, never a new glyph). Row0-left always
  # exists while drawing, so top-left is never erased. Bounds are the visible
  # session's [top, send), never the global window list.
  if (( top < send )); then seg='╭'; else seg=' '; fi
  for ((x = 1; x <= W - 2; x++)); do
    if ((x == vx)); then
      if (( top < send || top + 1 < send )); then seg+='┬'; else seg+=' '; fi
    elif ((x < vx)); then
      if (( top < send )); then seg+='─'; else seg+=' '; fi
    else
      if (( top + 1 < send )); then seg+='─'; else seg+=' '; fi
    fi
  done
  if (( top + 1 < send )); then seg+='╮'; else seg+=' '; fi
  put 0 0 "$seg"
  nput 0 2 ' Windows '
  sbar=$(sess_label); sbx=$(((W - ${#sbar}) / 2)); ((sbx < 12)) && sbx=12
  if ((bar)); then printf -v sbar '\x1b[7m%s\x1b[0m' "$sbar"; fi
  nput 0 "$sbx" "$sbar"
  for ((y = 1; y <= bot_y - 1; y++)); do
    ((y == mid_y)) && continue
    if ((y < mid_y)); then
      (( top < send )) && nput "$y" 0 '│'
      (( top + 1 < send )) && nput "$y" $((W - 1)) '│'
    else
      (( top + 2 < send )) && nput "$y" 0 '│'
      (( top + 3 < send )) && nput "$y" $((W - 1)) '│'
    fi
  done
  if (( top + 2 < send )); then seg='╰'; else seg=' '; fi
  for ((x = 1; x <= W - 2; x++)); do
    if ((x == vx)); then
      if (( top + 2 < send || top + 3 < send )); then seg+='┴'; else seg+=' '; fi
    elif ((x < vx)); then
      if (( top + 2 < send )); then seg+='─'; else seg+=' '; fi
    else
      if (( top + 3 < send )); then seg+='─'; else seg+=' '; fi
    fi
  done
  if (( top + 3 < send )); then seg+='╯'; else seg+=' '; fi
  put "$bot_y" 0 "$seg"
  for ((y = 1; y <= bot_y - 1; y++)); do
    ((y == mid_y)) && continue
    if ((y < mid_y)); then
      (( top < send || top + 1 < send )) && nput "$y" "$vx" '│'
    else
      (( top + 2 < send || top + 3 < send )) && nput "$y" "$vx" '│'
    fi
  done
  if (( top < send || top + 2 < send )); then seg='├'; else seg=' '; fi
  for ((x = 1; x <= W - 2; x++)); do
    if ((x == vx)); then
      if (( top < send || top + 1 < send || top + 2 < send || top + 3 < send )); then seg+='┼'; else seg+=' '; fi
    elif ((x < vx)); then
      if (( top < send || top + 2 < send )); then seg+='─'; else seg+=' '; fi
    else
      if (( top + 1 < send || top + 3 < send )); then seg+='─'; else seg+=' '; fi
    fi
  done
  if (( top + 1 < send || top + 3 < send )); then seg+='┤'; else seg+=' '; fi
  put "$mid_y" 0 "$seg"
  for ((r = 0; r < VROWS; r++)); do
    if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
    for ((c = 0; c < COLS; c++)); do
      idx=$((top + r * COLS + c))
      if ((c == 0)); then coff=2; else coff=$((vx + 2)); fi
      if ((idx < send)); then
        if ((idx == sel && bar == 0)); then put "$roff" "$coff" "$(title_cell "$idx" 1)"
        else put "$roff" "$coff" "$(title_cell "$idx" 0)"; fi
        declare -n ref="SNAP_$idx"
        for ((l = 0; l < snap_h; l++)); do
          put $((roff + 1 + l)) "$coff" "${ref[$l]:-}"
        done
      else
        for ((l = 0; l < band_h; l++)); do
          put $((roff + l)) "$coff" "$(printf '%*s' "$cell_w" '')"
        done
      fi
    done
  done
  # Cell puts use EL (clear-to-EOL), wiping the middle gutter + right border
  # on touched rows. Restore them with no-EL writes after the cells.
  for ((r = 0; r < VROWS; r++)); do
    if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
    for ((l = 0; l < band_h; l++)); do
      y=$((roff + l))
      if ((r == 0)); then
        (( top < send )) && nput "$y" 0 '│'
        (( top < send || top + 1 < send )) && nput "$y" "$vx" '│'
        (( top + 1 < send )) && nput "$y" $((W - 1)) '│'
      else
        (( top + 2 < send )) && nput "$y" 0 '│'
        (( top + 2 < send || top + 3 < send )) && nput "$y" "$vx" '│'
        (( top + 3 < send )) && nput "$y" $((W - 1)) '│'
      fi
    done
  done
  put $((H - 1)) 0 "$(footext)"
  printf '%s' "$FRAME"
}

move_down() {
  local next=$((sel + COLS))
  if ((next < send)); then sel=$next; return; fi
  local last_start=$(( (send - 1 - s0) / COLS * COLS + s0 ))
  if ((sel < last_start)); then
    local t=$((last_start + (sel - s0) % COLS))
    ((t >= send)) && t=$((send - 1))
    sel=$t
  fi
}

# Jump to a window, switching session first when it lives elsewhere.
jump_win() {
  local j=$1 wsess
  wsess=${WIN_SESS[$j]}
  [[ $wsess != "$cur_sid" ]] && tmux switch-client -t "$wsess" 2>/dev/null
  tmux select-window -t "${IDS[$j]}"
  exit 0
}

draw
while IFS= read -rsn1 k; do
  prev=$sel; prev_sess=$sess; prev_bar=$bar
  if [[ $k == $'\x1b' ]]; then
    IFS= read -rsn1 -t 0.1 b || break
    [[ $b == '[' ]] || continue
    IFS= read -rsn1 -t 0.1 d || continue
    case $d in
      A) if ((bar)); then continue
         elif ((sel >= s0 + COLS)); then sel=$((sel - COLS))
         else bar=1; draw; continue; fi ;;
      B) if ((bar)); then bar=0; draw; continue
         else move_down; fi ;;
      C) if ((bar)); then switch_sess 1; continue
         else ((sel + 1 < send)) && sel=$((sel + 1)); fi ;;
      D) if ((bar)); then switch_sess -1; continue
         else ((sel > s0)) && sel=$((sel - 1)); fi ;;
      *) continue ;;
    esac
  elif [[ -z $k || $k == $'\n' ]]; then
    if ((bar)); then tmux switch-client -t "${SESS_IDS[$sess]}"; exit 0; fi
    jump_win "$sel"
  elif [[ $k == [qQ] ]]; then
    break
  elif [[ $k == [0-9] ]]; then
    for ((j = s0; j < send; j++)); do
      if [[ ${WIDX[$j]} == "$k" ]]; then
        jump_win "$j"
      fi
    done
  elif [[ $k == [wW] ]]; then
    if ((bar)); then continue
    elif ((sel >= s0 + COLS)); then sel=$((sel - COLS))
    else bar=1; draw; continue; fi
  elif [[ $k == [sS] ]]; then
    if ((bar)); then bar=0; draw; continue
    else move_down; fi
  elif [[ $k == [aA] ]]; then
    if ((bar)); then switch_sess -1; continue
    else ((sel > s0)) && sel=$((sel - 1)); fi
  elif [[ $k == [dD] ]]; then
    if ((bar)); then switch_sess 1; continue
    else ((sel + 1 < send)) && sel=$((sel + 1)); fi
  else
    continue
  fi
  if ((prev == sel && prev_sess == sess && prev_bar == bar)); then continue; fi
  if ((bar == 0 && prev_bar == 0 && sel >= top && sel <= top + COLS * VROWS - 1 && prev >= top && prev <= top + COLS * VROWS - 1)); then
    # Repaint whole title rows: per-cell EL wipes the sibling, so clear
    # once per row and rewrite both cells + gutter + borders.
    if (((prev - top) / COLS == (sel - top) / COLS)); then
      paint_row $(((sel - top) / COLS))
    else
      paint_row $(((prev - top) / COLS))
      paint_row $(((sel - top) / COLS))
    fi
    at $((H - 1)) 0; footext
  else
    while ((sel < top)); do top=$((top - COLS)); done
    while ((sel > top + COLS * VROWS - 1)); do top=$((top + COLS)); done
    draw
  fi
done
exit 0
