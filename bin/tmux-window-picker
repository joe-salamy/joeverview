#!/usr/bin/env bash
# Arrow-navigated 2x2 snapshot grid for tmux windows across sessions. Bound to `prefix o`.
# Full keys: docs/USAGE.md in the repo.
# Each cell shows the BOTTOM-LEFT of the active pane capture, truncated to cell width at full resolution.
# Architecture map (read this before hacking):
#   STATE (globals): SESS_IDS/NAMES/START/COUNT + IDS/TITLES/ALERTS/WIDX/WIN_SESS
#     arrays, rebuilt by load_data(); SNAP[wid] capture cache keyed by stable
#     window_id so survivors keep captures across refreshes; SESS_MED medallion
#     cache keyed by session_id (value "outer"$'\x1f'"inner"$'\x1f'"width");
#     sel/sess/top/bar hold cursor/session/page/focus.
#   LOAD: load_data() re-reads metadata and GCs dead IDs; fault_visible()
#     faults titles (when TITLES_DIRTY) + missing visible captures +
#     medallion name in one batch_trunc() pass (raw captures in parallel),
#     so a cold open costs one interpreter spawn + ~1 tmux RTT for captures.
#   PAINT: draw() is the only full repaint (buffered into FRAME, one flush);
#     paint_row() repaints a single title row for same-page moves. put/nput
#     append cursor-addressed writes to FRAME (put clears to EOL first);
#     footext() owns the footer text, paint_footer() renders it.
#   INPUT: main loop at the bottom (draw, then read-key dispatch). Mutations go
#     through do_* helpers, which reload via refresh_to() (keyword args
#     sid=/wid=/off=/bar=1, reseat sel/sess/top by stable ID) and redraw.
#     Arrow keys and WASD share nav_up/nav_down/nav_left/nav_right. Footer is
#     the contract: grid focus runs window ops only, bar focus session ops
#     only — see docs/USAGE.md.
set -u
COLS=2; VROWS=2  # Fixed 2x2: mid_y/bot_y and the single mid divider assume VROWS=2.

command -v python3 >/dev/null 2>&1 || { echo "tmux-window-picker needs python3" >&2; exit 1; }
# Hide the cursor and clear before any blocking work (tmux round-trips,
# python spawns): the popup starts with a visible cursor at 0,0, so hiding
# after load_data() flashes it for the whole load.
saved_stty=$(stty -g 2>/dev/null || true)
JVTMP=$(mktemp -d "${TMPDIR:-/tmp}/jv.XXXXXX") || { echo "tmux-window-picker needs a temp dir" >&2; exit 1; }
cleanup() { printf '%s' $'\x1b[?25h'; [[ -n ${JVTMP:-} ]] && rm -rf "$JVTMP"; [ -n "${saved_stty:-}" ] && stty "$saved_stty" 2>/dev/null; }
trap cleanup EXIT
printf '\x1b[?25l\x1b[2J'
stty -echo -icanon min 1 time 0 2>/dev/null

# Visible-width-aware truncation: keeps SGR colors atomic, strips OSC
# hyperlinks, never splits UTF-8 (system `cut -c` counts bytes). Program goes
# via -c so the data stream keeps stdin (a heredoc would swallow the pipe).
# Optional second arg keeps only the last N non-blank (has a visible
# non-space char) lines, so top-anchored TUIs stay identifiable instead of
# showing blank tail. SGR-colored padding still counts as blank.
PY_COMMON="import re, sys, unicodedata
osc = re.compile(r'\x1b\][^\x07\x1b]*(?:\x07|\x1b\\\\)')
sgr = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
def vw(ch):
    return 2 if unicodedata.east_asian_width(ch) in (\"W\",\"F\") else (0 if unicodedata.combining(ch) else 1)
def trunc_line(line, w):
    line = osc.sub('', line)
    out = []
    v = 0
    saw = False
    done = False
    for tok in re.split(r'(\x1b\[[0-9;]*[A-Za-z])', line):
        if done or not tok:
            continue
        if sgr.fullmatch(tok):
            out.append(tok)
            saw = True
            continue
        for ch in tok:
            c = vw(ch)
            if v + c > w:
                done = True
                break
            out.append(ch)
            v += c
    if saw:
        out.append('\x1b[0m')
    while out and len(out[-1]) == 1 and out[-1] in ' \t':
        out.pop()
    return ''.join(out)
"
PY="$PY_COMMON
w = int(sys.argv[1])
rows = []
for raw in sys.stdin:
    rows.append(trunc_line(raw.rstrip('\n'), w))
sys.stdout.write('\n'.join(rows) + ('\n' if rows else ''))"
# Batch truncation for one fault: titles + missing visible captures +
# medallion name in a single python spawn (argv: title_w cell_w snap_h medw
# multi), raw captures fed in parallel so N cells cost ~1 tmux RTT, not N.
# Framing: stdin is NUL-joined blocks (titles, one raw capture per missing
# cell, medallion source name); stdout is NUL-joined blocks (titles, one
# truncated capture per missing cell, medallion name + outer width). Python
# never sees counts: every middle block is a capture, so bash indexes output
# as BATCH[0]=titles, BATCH[1..nmiss]=captures, BATCH[1+nmiss]=medallion.
# The medallion width is the arrow/name padding (10 multi / 4 single) plus
# the name's visible width, computed where the width rule already lives.
# Empty blocks stay empty: python emits a bare separator (no trailing
# newline), so mapfile -d '' keeps blocks aligned and empty captures stay
# unpinned exactly like trunc() does. Newlines split exactly like $PY's stdin
# loop (one trailing newline adds no row; CR/CRLF normalize). Bytes: python
# reads and writes UTF-8 with errors=replace so a stray byte never kills a
# draw; NULs are stripped from raw captures (tr -d) since NUL separates blocks.
# trunc_line reuses the shared PY_COMMON width rule with $PY.
BATCHPY="$PY_COMMON
title_w, cell_w, snap_h, medw, multi = (int(a) for a in sys.argv[1:6])
def trunc_block(lines, w, keep=None):
    rows = []
    for raw in lines:
        line = trunc_line(raw, w)
        content = any(not ch.isspace() for ch in sgr.sub('', line))
        rows.append((content, line))
    if keep is not None:
        texts = [t for c, t in rows if c][-keep:] if keep > 0 else []
    else:
        texts = [t for _, t in rows]
    return texts
def vwidth(s):
    return sum(vw(c) for c in sgr.sub('', s))
def lines_of(b):
    # Same line splitting \$PY saw: text-mode stdin normalizes CRLF/CR to LF,
    # then iterates lines (one trailing newline adds no phantom row).
    t = b.decode('utf-8', 'replace').replace('\r\n', '\n').replace('\r', '\n').split('\n')
    if t and t[-1] == '':
        t.pop()
    return t
parts = sys.stdin.buffer.read().split(b'\x00')
titles = trunc_block(lines_of(parts[0]), title_w)
caps = [trunc_block(lines_of(p), cell_w, snap_h) for p in parts[1:-1]]
med_src = lines_of(parts[-1])
medname = trunc_line(med_src[0] if med_src else '', medw)
med = medname + '\n' + str((10 if multi else 4) + vwidth(medname))
sys.stdout.buffer.write(b'\x00'.join([('\n'.join(titles)).encode('utf-8')] + [('\n'.join(c)).encode('utf-8') for c in caps] + [med.encode('utf-8')]) + b'\x00')"
batch_trunc() { python3 -c "$BATCHPY" "$@"; }
trunc() { python3 -c "$PY" "$@"; }
# Width-1 non-ASCII literals this script measures (frame, arrows, footer).
# Each is east_asian_width A/N + combining 0, so visible width is 1. vwidth
# folds them to 'x' and measures pure bash when nothing else non-ASCII
# remains; anything else (tmux-supplied text) falls back to python, so a
# literal missing here costs a spawn but never mismeasures.
W1='←→↑↓·⧉│─╭╮╰╯┬┴┼┤├'
# Visible width of one line (same east_asian_width rule as PY def vw):
# strip SGR, count wide→2, combining→0. Script-generated strings (footer,
# medallion with an ASCII session name, rename prompt) take the pure-bash
# path; only tmux-supplied wide text spawns python.
vwidth() {
  local s=$1 folded
  case $s in
    *$'\x1b'*) printf '%s' "$s" | python3 -c "$VW_PY" ;;
    *)
      folded=${s//[$W1]/x}
      if [[ $folded != *[![:ascii:]]* ]]; then printf '%s' "${#folded}"
      else printf '%s' "$s" | python3 -c "$VW_PY"; fi ;;
  esac
}
# shares the PY_COMMON width rule (wide→2, combining→0).
VW_PY='import re,sys,unicodedata; t=re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", sys.stdin.read()); print(sum(2 if unicodedata.east_asian_width(c) in ("W","F") else (0 if unicodedata.combining(c) else 1) for c in t))'

# Popup canvas is the fullscreen popup's own tty, not the invoker pane:
# #{pane_height}/#{pane_width} shrink the grid when opened from a split.
read -r H W < <(stty size 2>/dev/null) 2>/dev/null || read -r H W < <(tmux display-message -p '#{client_height} #{client_width}')
read -r cur_sid cur < <(tmux display-message -p '#{session_id} #{window_id}')
MIN_H=11        # title + 2 bands + mid + footer + frame
FRAME_W=7       # left/right borders + gutters + title padding
TITLE_PAD=2     # title rows indent 2 inside the cell
SB_MIN_X=12     # medallion never overlaps the ' Windows ' stamp
SB_BORDER_PAD=34  # medallion max width reserve (multi-session arrows)
SB_SINGLE_PAD=28  # medallion max width reserve (bare name)
(( H < MIN_H )) && H=MIN_H
cell_w=$(((W - FRAME_W) / COLS)); ((cell_w < 4)) && cell_w=4
title_w=$((cell_w - TITLE_PAD)); ((title_w < 2)) && title_w=2
band_h=$(((H - 9) / VROWS)); ((band_h < 1)) && band_h=1
snap_h=$((band_h - 1))
vx=$((TITLE_PAD + cell_w + 1))
bot_y=$((H - 2))
mid_y=$((band_h + 3))

declare -a SESS_IDS SESS_NAMES SESS_START SESS_COUNT
declare -a IDS TITLES ALERTS WIDX WIN_SESS RAW_TITLES
declare -A SNAP SESS_MED
declare -g nsess n
TITLES_DIRTY=0
# Rebuild session/window metadata from tmux. Snapshots (SNAP assoc only)
# are keyed by stable window_id, so surviving cells keep their captures
# across create/kill refreshes; only the missing ones fault in via
# fault_visible(). Stale windows/sessions are garbage-collected here.
# SESS_MED is dropped on every load; the medallion faults fresh inside the
# fault_visible() batch, so no surgical invalidation is needed.
# Globals written: nsess n (counts), the SESS_* and IDS/* arrays, and the
# SNAP/SESS_MED caches (loop index i and scratch k are local).
# Returns 1 when no windows remain.
load_data() {
  local sid sname wid widx wname wtitle wpath panes alert suffix c k idx
  local wsid row rest
  local -A seen
  local -a WINROWS
  SESS_IDS=(); SESS_NAMES=(); SESS_START=(); SESS_COUNT=()
  IDS=(); TITLES=(); ALERTS=(); WIDX=(); WIN_SESS=(); RAW_TITLES=()
  nsess=0; idx=0
  while IFS=$'\t' read -r sid sname; do
    SESS_IDS[$nsess]=$sid
    SESS_NAMES[$nsess]=$sname
    nsess=$((nsess + 1))
  done < <(tmux list-sessions -F "#{session_id}	#{session_name}")
  # One batched list-windows -a for all sessions (was one list-windows per
  # session: 1+nsess tmux round-trips on every open/refresh). Rows regroup
  # below in list-sessions order, whatever order tmux returns; windows from
  # sessions born after list-sessions are skipped until the next refresh.
  # The bell/activity flag field stays last: read with IFS tab drops a
  # trailing empty field, so nothing significant may follow it.
  mapfile -t WINROWS < <(tmux list-windows -a -F "#{session_id}	#{window_id}	#{window_index}	#{window_name}	#{pane_title}	#{pane_current_path}	#{window_panes}	#{?window_bell_flag,B,}#{?window_activity_flag,A,}")
  for ((k = 0; k < nsess; k++)); do
    sid=${SESS_IDS[$k]}
    SESS_START[$k]=$idx
    c=0
    for row in ${WINROWS[@]+"${WINROWS[@]}"}; do
      rest=$row
      wsid=${rest%%$'\t'*}; if [[ $rest == *$'\t'* ]]; then rest=${rest#*$'\t'}; else rest=""; fi
      wid=${rest%%$'\t'*}; if [[ $rest == *$'\t'* ]]; then rest=${rest#*$'\t'}; else rest=""; fi
      widx=${rest%%$'\t'*}; if [[ $rest == *$'\t'* ]]; then rest=${rest#*$'\t'}; else rest=""; fi
      wname=${rest%%$'\t'*}; if [[ $rest == *$'\t'* ]]; then rest=${rest#*$'\t'}; else rest=""; fi
      wtitle=${rest%%$'\t'*}; if [[ $rest == *$'\t'* ]]; then rest=${rest#*$'\t'}; else rest=""; fi
      wpath=${rest%%$'\t'*}; if [[ $rest == *$'\t'* ]]; then rest=${rest#*$'\t'}; else rest=""; fi
      panes=${rest%%$'\t'*}; if [[ $rest == *$'\t'* ]]; then rest=${rest#*$'\t'}; else rest=""; fi
      alert=$rest
      [[ $wsid == "$sid" ]] || continue
      IDS[$idx]=$wid
      WIDX[$idx]=$widx
      ALERTS[$idx]=$alert
      WIN_SESS[$idx]=$sid
      seen[$wid]=1
      suffix=""
      if ((panes > 1)); then suffix=" ⧉ $panes"; fi
      RAW_TITLES[$idx]="[$widx] $wname │ $wtitle │ $wpath$suffix"
      idx=$((idx + 1)); c=$((c + 1))
    done
    SESS_COUNT[$k]=$c
  done
  n=$idx
  [ "$n" -eq 0 ] && return 1
  # Drop snapshots for dead IDs; survivors keep their cache so
  # add/delete only captures the missing cells in fault_visible().
  # shellcheck disable=SC2199 # [@]+x is an emptiness probe, never expanded
  if [[ -n ${SNAP[@]+x} ]]; then
    for k in "${!SNAP[@]}"; do
      if [[ -z ${seen[$k]+_} ]]; then unset "SNAP[$k]" 2>/dev/null || true; fi
    done
  fi
  SESS_MED=()
  # Titles truncate in the fault_visible() batch, not here: batching needs
  # top/sess (unknown until the caller reseats), and an r-refresh faults the
  # new page's captures in the same spawn. TITLES_DIRTY=1 forces the fault.
  TITLES_DIRTY=1
}
# Clamp top so sel sits on the visible page.
place_top() {
  local rstart cnt max_top
  rstart=$(( sel - (sel - s0) % COLS ))
  cnt=$((send - s0))
  max_top=$(( (cnt - 3) / COLS * COLS + s0 ))
  (( max_top < s0 )) && max_top=$s0
  if (( rstart < max_top )); then top=$rstart; else top=$max_top; fi
}
# Re-read metadata and reseat sess/sel/top by stable ID (wid="" falls back
# to off, then clamps into the session). bar=1 preserves session-bar focus
# for r. Full draw; exits quietly when nothing remains (e.g. last window
# killed). Keyword args, all optional: sid= wid= off= bar=1.
refresh_to() {
  local want_sid="" want_wid="" want_off="" keep_bar=0 a k found=0
  for a in "$@"; do
    case $a in
      sid=*) want_sid=${a#sid=} ;;
      wid=*) want_wid=${a#wid=} ;;
      off=*) want_off=${a#off=} ;;
      bar=1) keep_bar=1 ;;
    esac
  done
  load_data || exit 0
  sess=0
  if [[ -n $want_sid ]]; then
    for ((k = 0; k < nsess; k++)); do
      if [[ ${SESS_IDS[$k]} == "$want_sid" ]]; then sess=$k; found=1; break; fi
    done
  else
    found=1
  fi
  s0=${SESS_START[$sess]}; send=$((s0 + SESS_COUNT[$sess]))
  sel=$s0
  if [[ -n $want_wid ]]; then
    for ((k = s0; k < send; k++)); do
      if [[ ${IDS[$k]} == "$want_wid" ]]; then sel=$k; break; fi
    done
  elif [[ -n $want_off ]] && (( found )); then
    sel=$((s0 + want_off))
  fi
  (( sel < s0 )) && sel=$s0
  (( sel >= send )) && sel=$((send - 1))
  bar=$keep_bar
  place_top
  draw
}
# New window in the viewed session, starting in the selected cell's
# directory; grid cursor lands on it. Created detached (-d) so the
# underlying client keeps its window — overview stays open. Falls back
# to tmux default-path when the path is empty/unreadable (e.g. deleted dir).
do_new_window() {
  (( bar )) && return 0
  local target newid dir
  target=${SESS_IDS[$sess]}
  dir=$(tmux display-message -p -t "${IDS[$sel]}" '#{pane_current_path}' 2>/dev/null) || dir=""
  if [[ -n $dir ]]; then newid=$(tmux new-window -d -P -F "#{window_id}" -t "$target" -c "$dir" 2>/dev/null) || newid=$(tmux new-window -d -P -F "#{window_id}" -t "$target" 2>/dev/null) || return 0
  else newid=$(tmux new-window -d -P -F "#{window_id}" -t "$target" 2>/dev/null) || return 0; fi
  # Window ids are unique: load_data GCs dead IDs and fault_visible() faults
  # the new window in fresh.
  refresh_to sid="$target" wid="$newid"
}
# Kill the selected window (grid focus only); stays at the same offset so
# the next window slides under the cursor (clamped at the end).
do_kill_window() {
  (( bar )) && return 0
  local target=${SESS_IDS[$sess]} off=$((sel - s0))
  tmux kill-window -t "${IDS[$sel]}" 2>/dev/null || return 0
  refresh_to sid="$target" off="$off"
}
# New detached session; grid lands on it with bar focus so the user can
# keep paging or dive in (Down, then c for windows). Full refresh.
do_new_session() {
  local newsid
  (( bar )) || return 0
  newsid=$(tmux new-session -d -P -F "#{session_id}" 2>/dev/null) || return 0
  refresh_to sid="$newsid" bar=1
}
# Kill the viewed session (bar focus only, never the last one — killing
# the sole session would strand the client); lands on the session now at
# the same position (neighbour slides in, clamped at the end) with bar
# focus, keeping the window offset like kill-window. Pre-switches the
# client when killing the attached session so the popup survives.
do_kill_session() {
  local target=${SESS_IDS[$sess]} fallback="" attached="" off=$((sel - s0))
  (( nsess > 1 )) || return 0
  if (( sess + 1 < nsess )); then fallback=${SESS_IDS[$((sess + 1))]}
  else fallback=${SESS_IDS[$((sess - 1))]}; fi
  attached=$(tmux display-message -p '#{session_id}' 2>/dev/null) || attached=""
  attached=${attached%% *}  # live reply is one id; other contexts may append the window id
  if [[ -n $attached && $target == "$attached" ]]; then
    tmux switch-client -t "$fallback" 2>/dev/null || return 0
  fi
  tmux kill-session -t "$target" 2>/dev/null || return 0
  refresh_to sid="$fallback" off="$off" bar=1
}
# Footer-inline confirm for session kill (bar focus only): X arms the
# prompt on the footer row (no draw, no cache drop); y/Y commits via
# do_kill_session, anything else redraws unchanged. Lone Esc aborts
# instead of quitting; arrow-key escapes are consumed so no bytes leak
# into the next read. Sole session never arms (kill refused, as before).
# Prompt is truncated to W like the footer (small-canvas discipline).
ask_kill_session() {
  local nm cnt maxw
  (( bar )) || return 0
  (( nsess > 1 )) || return 0
  cnt=${SESS_COUNT[$sess]}
  maxw=$((W - SB_BORDER_PAD)); (( maxw < 8 )) && maxw=8
  nm=$(printf '%s' "${SESS_NAMES[$sess]}" | trunc "$maxw")
  confirm_armed=1
  at $((H - 1)) 0
  printf '%s' "$(printf '\x1b[1;31mKill session %s (%d windows)? y/N\x1b[0m' "$nm" "$cnt" | trunc "$W")"
}
# Swap the selected window with its neighbour within the viewed session;
# cursor follows the moved window by stable ID. Grid focus only.
do_move_window() {
  local dir=$1 wid target
  (( bar )) && return 0
  wid=${IDS[$sel]}
  if (( dir < 0 )); then
    (( sel <= s0 )) && return 0
    target=${IDS[$((sel - 1))]}
  else
    (( sel + 1 >= send )) && return 0
    target=${IDS[$((sel + 1))]}
  fi
  tmux swap-window -s "$wid" -t "$target" 2>/dev/null || return 0
  refresh_to sid="${SESS_IDS[$sess]}" wid="$wid"
}
# Rename prompt on the footer row: leaves nav mode, shows the cursor, reads
# a line char-by-char with manual echo. Enter submits, Backspace erases,
# lone Esc aborts ("" = keep). Escape sequences are not text: Esc aborts and
# any trailing bytes reprocess as nav keys. Sets READ_NAME ("" = keep).
# Called directly (never in $()) so the prompt reaches the popup tty.
read_name() {
  local kind=$1 old=$2 ch buf="" maxold prompt prompt_visible buf_visible RENAME_PAD=20 old_stty
  old_stty=$(stty -g 2>/dev/null || true)
  READ_NAME=""
  maxold=$((W - RENAME_PAD)); (( maxold < 4 )) && maxold=4
  old=$(printf '%s' "$old" | trunc "$maxold")
  at $((H - 1)) 0
  printf '\x1b[?25h'
  stty -echo -icanon min 1 time 0 2>/dev/null || true
  printf 'rename %s [%s]: ' "$kind" "$old"
  prompt="rename $kind [$old]"
  prompt_visible=$(vwidth "$prompt")
  while IFS= read -rsn1 ch || { buf=""; break; }; do
    if [[ -z ${ch:-} || $ch == $'\n' || $ch == $'\r' ]]; then
      break
    elif [[ $ch == $'\x1b' ]]; then
      buf=""
      break
    elif [[ $ch == $'\x7f' || $ch == $'\b' ]]; then
      if [[ -n $buf ]]; then
        buf=${buf%?}
        printf '\b \b'
      fi
    elif [[ $ch < $' ' ]]; then
      continue
    else
      buf_visible=$(vwidth "$buf$ch")
      if (( prompt_visible + buf_visible >= W - 1 )); then
        continue
      fi
      buf+=$ch
      printf '%s' "$ch"
    fi
  done
  READ_NAME=$buf
  [ -n "${old_stty:-}" ] && stty "$old_stty" 2>/dev/null || true
  printf '\x1b[?25l'
}
# Rename the selected window (grid focus only); snapshots are keyed by
# stable ID so the capture survives, titles rebuild in refresh_to.
do_rename_window() {
  (( bar )) && return 0
  local wid=${IDS[$sel]} sid=${SESS_IDS[$sess]} old
  old=$(tmux display-message -p -t "$wid" '#{window_name}' 2>/dev/null) || old=""
  read_name "window" "$old"
  [[ -z ${READ_NAME:-} || $READ_NAME == "$old" ]] && { draw; return 0; }
  tmux rename-window -t "$wid" "$READ_NAME" 2>/dev/null || { draw; return 0; }
  refresh_to sid="$sid" wid="$wid"
}
# Rename the viewed session (bar focus only); drops the cached medallion
# so the new name stamps fresh, keeping the window offset behind the bar.
# Empty input keeps the old name.
do_rename_session() {
  (( bar )) || return 0
  local sid=${SESS_IDS[$sess]} old off=$((sel - s0))
  old=${SESS_NAMES[$sess]}
  read_name "session" "$old"
  [[ -z ${READ_NAME:-} || $READ_NAME == "$old" ]] && { draw; return 0; }
  tmux rename-session -t "$sid" "$READ_NAME" 2>/dev/null || { draw; return 0; }
  refresh_to sid="$sid" off="$off" bar=1
}

load_data || exit 0
sess=0
for ((k = 0; k < nsess; k++)); do
  if [[ ${SESS_IDS[$k]} == "$cur_sid" ]]; then sess=$k; break; fi
done
s0=${SESS_START[$sess]}; send=$((s0 + SESS_COUNT[$sess]))
sel=$s0
for ((k = s0; k < send; k++)); do
  if [[ ${IDS[$k]} == "$cur" ]]; then sel=$k; break; fi
done
place_top
# On-demand snapshots keyed by stable window_id: a present non-empty SNAP entry
# is the loaded flag. Empty captures (fresh shell pre-paint) are never pinned
# so later draws retry. draw() faults its page in one batch (titles when
# TITLES_DIRTY, missing captures, medallion name), so scrolls and session
# switches fault missing cells in synchronously, while add/delete refreshes
# reuse surviving cells and capture only the new one.
# Raw captures run in parallel tmux round-trips into JVTMP files, then one
# batch_trunc() pass truncates everything: N cells cost ~1 RTT + 1 spawn.
# mapfile -d '' keeps empty blocks aligned (plain mapfile would drop a
# trailing empty medallion). Subshells cannot write SNAP, so raw (not
# truncated) captures stage through files. The footer stays out of the batch:
# its char length pre-check (paint_footer) usually avoids a spawn, and a
# per-row keypress path (trunc_footer_direct) must not pay a batch round-trip.
fault_visible() {
  local e=$((top + COLS * VROWS)) k wid key nmiss=0 bi row
  local -a MW=()
  local -a BATCH=()
  local medw med_src multi=0
  ((e > send)) && e=$send
  # snap_h<=0 (tiny canvas): no captures exist, so skip the scan; the batch
  # below still runs when titles or the medallion are actually dirty.
  if (( snap_h > 0 )); then
    for ((k = top; k < e; k++)); do
      wid=${IDS[$k]}
      if [[ -z ${SNAP[$wid]:-} ]]; then
        key=${wid//[!A-Za-z0-9_]/}
        MW+=("$k:$key")
      fi
    done
    nmiss=${#MW[@]}
  fi
  # Medallion rides the batch so a dropped cache entry faults even when titles/captures are clean.
  if (( TITLES_DIRTY == 0 && nmiss == 0 )) && [[ -n ${SESS_MED[${SESS_IDS[$sess]}]+_} ]]; then return 0; fi
  if (( nsess > 1 )); then multi=1; medw=$((W - SB_BORDER_PAD)); else medw=$((W - SB_SINGLE_PAD)); fi
  (( medw < 4 )) && medw=4
  med_src=${SESS_NAMES[$sess]}
  if (( nmiss > 0 )); then
    for row in ${MW[@]+"${MW[@]}"}; do
      k=${row%%:*}; key=${row#*:}
      tmux capture-pane -pe -t "${IDS[$k]}" 2>/dev/null | tr -d '\0' >"$JVTMP/cap-$key" &
    done
    wait
  fi
  { printf '%s\n' "${RAW_TITLES[@]}"
    for row in ${MW[@]+"${MW[@]}"}; do
      key=${row#*:}
      printf '\0'
      if [[ -s $JVTMP/cap-$key ]]; then cat "$JVTMP/cap-$key"; fi
    done
    printf '\0%s' "$med_src"
  } >"$JVTMP/in"
  mapfile -d '' -t BATCH < <(batch_trunc "$title_w" "$cell_w" "$snap_h" "$medw" "$multi" <"$JVTMP/in")
  if (( TITLES_DIRTY )); then
    mapfile -t TITLES <<<"${BATCH[0]:-}"
    TITLES_DIRTY=0
  fi
  bi=1
  if (( nmiss > 0 )); then
    for row in ${MW[@]+"${MW[@]}"}; do
      k=${row%%:*}; key=${row#*:}
      wid=${IDS[$k]}
      if [[ -n ${BATCH[$bi]:-} ]]; then
        SNAP[$wid]=${BATCH[$bi]}
      else
        unset "SNAP[$wid]" 2>/dev/null || true
      fi
      bi=$((bi + 1))
    done
  fi
  cache_medallion "${BATCH[$bi]:-}"
  rm -f "$JVTMP"/cap-* "$JVTMP/in" 2>/dev/null || true
}
bar=0
confirm_armed=0

at() { printf '\x1b[%d;%dH\x1b[K' "$(($1 + 1))" "$(($2 + 1))"; }

put() { local cell; printf -v cell '\x1b[%d;%dH\x1b[K%s' "$(($1 + 1))" "$(($2 + 1))" "$3"; FRAME+=$cell; }
nput() { local cell; printf -v cell '\x1b[%d;%dH%s' "$(($1 + 1))" "$(($2 + 1))" "$3"; FRAME+=$cell; }
# Alert style: bell=bold red, activity=bold yellow (bell wins if both).
# Selected cells fold reverse into the same SGR so no inner reset kills it.
title_cell() {
  local idx=$1 selected=$2 sgr
  case "${ALERTS[$idx]}" in
    *B*) sgr='1;31' ;;
    *A*) sgr='1;33' ;;
    *) sgr='' ;;
  esac
  ((selected)) && sgr="7${sgr:+;$sgr}"
  if [[ -n $sgr ]]; then printf '\x1b[%sm%s\x1b[0m' "$sgr" "${TITLES[$idx]}"
  else printf '%s' "${TITLES[$idx]}"; fi
}
# Repaint one visible title row (both cells + gutter + borders) without
# wiping the sibling: clear once at row start, then write with no-EL moves.
paint_row() {
  local r=$1 roff base idx c coff
  if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
  base=$((top + r * COLS))
  # Arm-aware frame (junctions close with corners): skip border ticks with no occupied owner; never invent arms.
  at "$roff" 0
  (( base < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) 1 '│'
  for ((c = 0; c < COLS; c++)); do
    idx=$((base + c))
    if ((c == 0)); then coff=2; else coff=$((vx + 2)); fi
    if ((idx < send)); then
      if ((idx == sel)); then printf '\x1b[%d;%dH%s' $((roff + 1)) $((coff + 1)) "$(title_cell "$idx" 1)"
      else printf '\x1b[%d;%dH%s' $((roff + 1)) $((coff + 1)) "$(title_cell "$idx" 0)"; fi
    fi
  done
  (( base < send || base + 1 < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) $((vx + 1)) '│'
  (( base + 1 < send )) && printf '\x1b[%d;%dH%s' $((roff + 1)) "$W" '│'
  return 0
}
# Session medallion for the top border: padded arrows when paging is
# possible, padded bare name when it is not (single session hides session switching — the bar still focuses (session ops live there)).
# Truncated to fit between the
# ' Windows ' stamp and the corners. Focus keeps the same footprint: the
# outer 2 cells stay normal-video gap, only the inner core reverses, so the
# border length never changes with focus.
# Batch path: assembles outer/inner in pure bash from the batch-truncated
# name; the batch already measured the name width, so no vwidth spawn.
cache_medallion() {
  local sid=${SESS_IDS[$sess]} nm mlen outer inner
  nm=${1%%$'\n'*}; mlen=${1#*$'\n'}
  if (( nsess > 1 )); then outer="  ←  $nm  →  "; else outer="  $nm  "; fi
  inner=${outer:2:${#outer} - 4}
  SESS_MED[$sid]="$outer"$'\x1f'"$inner"$'\x1f'"$mlen"
}
# The early return in fault_visible() covers the cache-hit path: a dropped
# entry rides the batch, so no separate fault is needed.
# Split the SESS_MED[sid] triple into sbar/sinner/sblen globals.
split_medallion() {
  IFS=$'\x1f' read -r sbar sinner sblen <<<"${SESS_MED[${SESS_IDS[$sess]}]}"
}
# Footer is the contract: every working key for the current focus is listed,
# nothing unlisted works. Grid rows show window ops only (c = window,
# X = window); the bar shows session ops only (N = session, X = session).
footext() {
  local rel=$((top - s0)) cnt=$((send - s0)) hi lo
  hi=$((rel + 1)); lo=$((rel + COLS * VROWS)); ((lo > cnt)) && lo=$cnt
  if ((bar)); then
    if ((nsess > 1)); then printf '←→/ad switch · ↓/s back · Enter attach · N new-session · R rename · X kill-session · r refresh · q/Esc quit · session %d/%d' "$((sess + 1))" "$nsess"
    else printf '↓/s back · Enter attach · N new-session · R rename · r refresh · q/Esc quit · session %d/%d' "$((sess + 1))" "$nsess"; fi
  else printf '↑↓←→/WASD move · ↑ sessions · Enter/0-9 jump · c new-window · R rename · < > move window · X kill · r refresh · q/Esc quit · %d-%d/%d' "$hi" "$lo" "$cnt"; fi
}
# Render the footer row: truncate footext() to canvas width. The footer is
# near-ASCII, so skip the python truncation spawn when it already fits.
foot_trunc() {
  local text fw
  text=$(cat)
  if ((${#text} <= W)) && [[ $text != *$'\x1b'* ]]; then
    fw=$(vwidth "$text")
    if ((fw <= W)); then printf '%s' "$text"; return 0; fi
  fi
  printf '%s' "$text" | trunc "$W" | tr -d '\n'
}
paint_footer() {
  local text; text=$(footext); put $((H - 1)) 0 "$(printf '%s' "$text" | foot_trunc)"
}
# Page to the session `ns` steps away: reset to its first page, keep bar
# focus so the user can keep paging. Full draw — the only bar painter.
switch_sess() {
  (( nsess > 1 )) || return 0
  sess=$(( (sess + $1 + nsess) % nsess ))
  s0=${SESS_START[$sess]}; send=$((s0 + SESS_COUNT[$sess]))
  sel=$s0; top=$s0; bar=1
  draw
}
# Horizontal border row for one occupancy pair: ends + center junction
# follow the left/right occupancy ($4/$5); the mid divider is separate.
hborder() {
  local row=$1 le=$2 re=$3 ol=$4 or=$5 jb=$6 jl=$7 jr=$8 seg x
  if (( ol )); then seg=$le; else seg=' '; fi
  for ((x = 1; x <= W - 2; x++)); do
    if ((x == vx)); then
      if (( ol && or )); then seg+=$jb
      elif (( ol )); then seg+=$jl
      elif (( or )); then seg+=$jr
      else seg+=' '; fi
    elif ((x < vx)); then
      if (( ol )); then seg+='─'; else seg+=' '; fi
    else
      if (( or )); then seg+='─'; else seg+=' '; fi
    fi
  done
  if (( or )); then seg+=$re; else seg+=' '; fi
  put "$row" 0 "$seg"
}
# Pre-cell gutter/frame pass; restore_gutters() repaints the same cells after paint_cells (EL-then-restore). Both share occ().
occ() { (( top + $1 < send )); }
paint_gutters() {
  local y b2o=0 b3o=0
  occ 2 && b2o=1; occ 3 && b3o=1
  for ((y = 1; y <= bot_y - 1; y++)); do
    ((y == mid_y)) && continue
    if ((y < mid_y)); then
      if occ 0; then nput "$y" 0 '│'; else nput "$y" 0 ' '; fi
      if occ 1; then nput "$y" $((W - 1)) '│'; else nput "$y" $((W - 1)) ' '; fi
    else
      if occ 2; then nput "$y" 0 '│'; else nput "$y" 0 ' '; fi
      if occ 3; then nput "$y" $((W - 1)) '│'; else nput "$y" $((W - 1)) ' '; fi
    fi
  done
  hborder "$bot_y" '╰' '╯' "$b2o" "$b3o" '┴' '╯' '╰'
  for ((y = 1; y <= bot_y - 1; y++)); do
    ((y == mid_y)) && continue
    if ((y < mid_y)); then
      # Notch the divider where it passes under the session medallion,
      # so the column border never touches the session name.
      if { occ 0 || occ 1; } && (( y != 1 || vx < sbx || vx >= sbx + sblen )); then nput "$y" "$vx" '│'; else nput "$y" "$vx" ' '; fi
    else
      if occ 2 || occ 3; then nput "$y" "$vx" '│'; else nput "$y" "$vx" ' '; fi
    fi
  done
}
restore_gutters() {
  local r l y roff
  # Cell puts use EL (clear-to-EOL), wiping the middle gutter + right border
  # on touched rows. Restore them with no-EL writes after the cells.
  for ((r = 0; r < VROWS; r++)); do
    if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
    for ((l = 0; l < band_h; l++)); do
      y=$((roff + l))
      if ((r == 0)); then
        if occ 0; then nput "$y" 0 '│'; else nput "$y" 0 ' '; fi
        if occ 0 || occ 1; then nput "$y" "$vx" '│'; else nput "$y" "$vx" ' '; fi
        if occ 1; then nput "$y" $((W - 1)) '│'; else nput "$y" $((W - 1)) ' '; fi
      else
        if occ 2; then nput "$y" 0 '│'; else nput "$y" 0 ' '; fi
        if occ 2 || occ 3; then nput "$y" "$vx" '│'; else nput "$y" "$vx" ' '; fi
        if occ 3; then nput "$y" $((W - 1)) '│'; else nput "$y" $((W - 1)) ' '; fi
      fi
    done
  done
}
paint_cells() {
  local r c idx coff roff l lines blank
  printf -v blank '%*s' "$cell_w" ''
  for ((r = 0; r < VROWS; r++)); do
    if ((r == 0)); then roff=2; else roff=$((mid_y + 2)); fi
    for ((c = 0; c < COLS; c++)); do
      idx=$((top + r * COLS + c))
      if ((c == 0)); then coff=2; else coff=$((vx + 2)); fi
      if ((idx < send)); then
        if ((idx == sel && bar == 0)); then put "$roff" "$coff" "$(title_cell "$idx" 1)"
        else put "$roff" "$coff" "$(title_cell "$idx" 0)"; fi
        mapfile -t lines <<<"${SNAP[${IDS[$idx]}]:-}"
        for ((l = 0; l < snap_h; l++)); do
          put $((roff + 1 + l)) "$coff" "${lines[$l]:-}"
        done
      else
        for ((l = 0; l < band_h; l++)); do
          put $((roff + l)) "$coff" "$blank"
        done
      fi
    done
  done
}
mid_junction() {
  local l=$1 r=$2 u=$3 d=$4
  if (( l && r && u && d )); then printf '┼'
  elif (( l && r && u )); then printf '┴'
  elif (( l && r && d )); then printf '┬'
  elif (( l && u && d )); then printf '┤'
  elif (( r && u && d )); then printf '├'
  elif (( l && r )); then printf '─'
  elif (( u && d )); then printf '│'
  elif (( l && u )); then printf '╯'
  elif (( l && d )); then printf '╮'
  elif (( r && u )); then printf '╰'
  elif (( r && d )); then printf '╭'
  elif (( l || r )); then printf '─'
  elif (( u || d )); then printf '│'
  else printf ' '; fi
}
draw() {
  local b seg x y r c idx coff roff l sbar sinner sblen sbx lines u d
  local -a occ4
  fault_visible
  FRAME=$'\x1b[?25l'
  # Arm-aware frame: same geometry/sizes; each junction picks the glyph
  # matching its present arms (occ4[0..3] = visible occupancy of the 4 cells),
  # so edges close with corners instead of dangling tees/crosses.
  # Bounds are the visible session's [top, send), never the global list.
  for ((b = 0; b < 4; b++)); do occ4[$b]=0; occ "$b" && occ4[$b]=1; done
  hborder 0 '╭' '╮' "${occ4[0]}" "${occ4[1]}" '┬' '╮' '╭'
  nput 0 2 ' Windows '
  split_medallion
  sbx=$(((W - sblen) / 2)); ((sbx < SB_MIN_X)) && sbx=SB_MIN_X
  if (( sbx + sblen > W - 1 )); then sbx=$((W - 1 - sblen)); fi
  if (( sbx < 1 )); then sbx=1; sbar=$(printf '%s' "$sbar" | trunc "$((W - 2))"); sblen=$((W - 2)); fi
  if ((bar)); then
    # Same footprint focused or not: outer 2 stay normal-video gap, only the
    # inner core reverses, so the border length never changes with focus.
    printf -v sbar '  \x1b[7m%s\x1b[0m  ' "$sinner"
  fi
  nput 0 "$sbx" "$sbar"
  paint_gutters
  if (( occ4[0] && occ4[2] )); then seg='├'
  elif (( occ4[0] )); then seg='╰'
  elif (( occ4[2] )); then seg='╭'
  else seg=' '; fi
  for ((x = 1; x <= W - 2; x++)); do
    if ((x == vx)); then
      l=$(( occ4[0] || occ4[2] )); r=$(( occ4[1] || occ4[3] )); u=$(( occ4[0] || occ4[1] )); d=$(( occ4[2] || occ4[3] ))
      seg+=$(mid_junction "$l" "$r" "$u" "$d")
    elif ((x < vx)); then
      if (( occ4[0] || occ4[2] )); then seg+='─'; else seg+=' '; fi
    else
      if (( occ4[1] || occ4[3] )); then seg+='─'; else seg+=' '; fi
    fi
  done
  if (( occ4[1] && occ4[3] )); then seg+='┤'
  elif (( occ4[1] )); then seg+='╯'
  elif (( occ4[3] )); then seg+='╮'
  else seg+=' '; fi
  put "$mid_y" 0 "$seg"
  paint_cells
  restore_gutters
  paint_footer
  printf '%s' "$FRAME"
}

# Shared arrow/WASD navigation. Return 0 when fully handled (full draw done or no-op: caller skips repaint); return 1 when sel moved and the caller must repaint.
nav_up() {
  if ((bar)); then return 0
  elif ((sel >= s0 + COLS)); then sel=$((sel - COLS)); return 1
  else bar=1; draw; return 0; fi
}
nav_down() {
  if ((bar)); then bar=0; draw; return 0
  else local prev=$sel; move_down; ((prev == sel)) && return 0; return 1; fi
}
nav_left() {
  if ((bar)); then switch_sess -1; return 0
  elif ((sel > s0)); then sel=$((sel - 1)); return 1
  else return 0; fi
}
nav_right() {
  if ((bar)); then switch_sess 1; return 0
  elif ((sel + 1 < send)); then sel=$((sel + 1)); return 1
  else return 0; fi
}

move_down() {
  local next=$((sel + COLS))
  if ((next < send)); then sel=$next; return; fi
  local last_start=$(( (send - 1 - s0) / COLS * COLS + s0 ))
  if ((sel < last_start)); then
    local t=$((last_start + (sel - s0) % COLS))
    ((t >= send)) && t=$((send - 1))
    sel=$t
  fi
}

# Jump to a window, switching session first when it lives elsewhere.
jump_win() {
  local j=$1 wsess
  wsess=${WIN_SESS[$j]}
  [[ $wsess != "$cur_sid" ]] && tmux switch-client -t "$wsess" 2>/dev/null
  tmux select-window -t "${IDS[$j]}"
  exit 0
}

main() {
local prev k b d j
draw
while IFS= read -rsn1 k; do
  prev=$sel
  if ((confirm_armed)); then
    if [[ $k == $'\x1b' ]]; then
      # Consume the rest of any escape sequence so its bytes don't
      # reprocess as nav keys; lone Esc aborts instead of quitting.
      IFS= read -rsn1 -t 0.25 b || { confirm_armed=0; draw; continue; }
      if [[ $b == '[' ]]; then IFS= read -rsn1 -t 0.25 d || true; fi
      confirm_armed=0; draw; continue
    elif [[ $k == [yY] ]]; then
      confirm_armed=0; do_kill_session; continue
    else
      confirm_armed=0; draw; continue
    fi
  fi
  if [[ $k == $'\x1b' ]]; then
    IFS= read -rsn1 -t 0.25 b || break
    [[ $b == '[' ]] || continue
    IFS= read -rsn1 -t 0.25 d || continue
    case $d in
      [0-9]) while [[ $d != [A-Za-z~] ]]; do IFS= read -rsn1 -t 0.05 d || break; done; continue ;;
      A) nav_up && continue ;;
      B) nav_down && continue ;;
      C) nav_right && continue ;;
      D) nav_left && continue ;;
      *) continue ;;
    esac
  elif [[ -z $k || $k == $'\n' ]]; then
    if ((bar)); then tmux switch-client -t "${SESS_IDS[$sess]}"; exit 0; fi
    jump_win "$sel"
  elif [[ $k == [qQ] ]]; then
    break
  elif [[ $k == [0-9] ]]; then
    (( bar )) && continue
    for ((j = s0; j < send; j++)); do
      if [[ ${WIDX[$j]} == "$k" ]]; then
        jump_win "$j"
        break
      fi
    done
  # WASD shares the nav_* helpers with the arrow keys (single source).
  elif [[ $k == [wW] ]]; then
    nav_up && continue
  elif [[ $k == [sS] ]]; then
    nav_down && continue
  elif [[ $k == [aA] ]]; then
    nav_left && continue
  elif [[ $k == [dD] ]]; then
    nav_right && continue
  elif [[ $k == [cC] ]]; then
    do_new_window; continue
  elif [[ $k == [nN] ]]; then
    # Session creation lives on the session bar (strict two-mode).
    do_new_session; continue
  elif [[ $k == "<" ]]; then
    do_move_window -1; continue
  elif [[ $k == ">" ]]; then
    do_move_window 1; continue
  elif [[ $k == X ]]; then
    # Capital-only kill: lowercase x stays ignored as a fat-finger guard
    # beside WASD. Grid focus kills the window at once; bar focus arms a
    # footer y/N confirm and kills only on y (see ask_kill_session).
    if (( bar )); then ask_kill_session; else do_kill_window; fi; continue
  elif [[ $k == r ]]; then
    # Explicit refresh: drop all cached captures/medallions so pane content
    # and renamed sessions fault in fresh (c/X reuse the cache on purpose).
    # Lowercase only: R is rename (visible in both footers).
    SNAP=(); SESS_MED=()
    if ((bar)); then refresh_to sid="${SESS_IDS[$sess]}" bar=1
    else refresh_to sid="${SESS_IDS[$sess]}" wid="${IDS[$sel]}"; fi
    continue
  elif [[ $k == R ]]; then
    # Rename: window on grid focus, session on bar focus. Empty keeps old.
    if (( bar )); then do_rename_session; else do_rename_window; fi; continue
  else
    continue
  fi
  if ((prev == sel)); then continue; fi
  if ((sel >= top && sel <= top + COLS * VROWS - 1 && prev >= top && prev <= top + COLS * VROWS - 1)); then
    # Repaint whole title rows: per-cell EL wipes the sibling, so clear
    # once per row and rewrite both cells + gutter + borders.
    if (((prev - top) / COLS == (sel - top) / COLS)); then
      paint_row $(((sel - top) / COLS))
    else
      paint_row $(((prev - top) / COLS))
      paint_row $(((sel - top) / COLS))
    fi
    # Direct write (not put): FRAME is only flushed in draw().
    at $((H - 1)) 0; footext | foot_trunc
  else
    while ((sel < top)); do top=$((top - COLS)); done
    while ((sel > top + COLS * VROWS - 1)); do top=$((top + COLS)); done
    draw
  fi
done
}
main "$@"
